# GrokBotBuzzBridge settings. Copy to .env next to compose.yml and fill in.
# Never commit .env. The Grok Bot webhook key does NOT go here: it is pasted
# into the setup page (gbb setup-link) so it never passes through an AI agent.

# --- Required ----------------------------------------------------------------

# The Buzz community address, exactly as members type it in the Buzz app.
BUZZ_RELAY_URL=wss://community.example.com

# The public https address where Grok Bot reaches this bridge. Grok Bot runs
# in the cloud, so this must be reachable from the internet. A path is fine.
# See docs/install/04-public-address.md.
BRIDGE_PUBLIC_URL=https://community.example.com/grokbot

# --- Who the bot is ------------------------------------------------------------

# Display name and description shown in Buzz.
BRIDGE_BOT_NAME=Grok Bot
BRIDGE_BOT_ABOUT=I answer questions for this community. Mention me in a channel.
# Optional https link to a square image.
BRIDGE_BOT_AVATAR_URL=
# Shown to Grok Bot in every question. Defaults to the community's host name.
BRIDGE_COMMUNITY_NAME=

# --- Who can do what -----------------------------------------------------------

# Admins (npub or hex, comma separated). Admins can use !status, !pause and
# !resume, are never rate limited, and are marked isAdmin=true for Grok Bot.
BRIDGE_ADMINS=
# The bot's owner, the only person who can DM it (a Buzz safety rule).
# Defaults to the first admin.
BRIDGE_OWNER=
# anyone    = any member can ask (default)
# allowlist = only admins and the keys in BRIDGE_ALLOWLIST
BRIDGE_RESPOND_TO=anyone
BRIDGE_ALLOWLIST=

# --- Where it answers --------------------------------------------------------

# Channels where @mentions are answered: "all" or channel UUIDs (comma separated).
BRIDGE_ANSWER_IN=all
# Channels where EVERY message is treated as a question, no @mention needed.
# Good for a dedicated #ask-grok channel. Channel UUIDs, comma separated.
BRIDGE_OPEN_CHANNELS=
# Join the open channels above automatically (private ones need an admin).
BRIDGE_AUTO_JOIN=true
# Optional channel UUID where the bridge posts problems (failed deliveries, timeouts).
BRIDGE_ALERT_CHANNEL=

# --- Limits --------------------------------------------------------------------

# Questions per person per hour (admins exempt). 0 = no limit.
BRIDGE_RATE_LIMIT_PER_HOUR=6
# Minutes to wait for Grok Bot before posting a "taking longer" notice.
BRIDGE_TASK_TIMEOUT_MINUTES=10
# Most messages Grok Bot may post for one question.
BRIDGE_MAX_REPLIES_PER_TASK=5
# Largest image or video Grok Bot may attach, in MB.
BRIDGE_MAX_ATTACHMENT_MB=25
# Emoji added to a question when it is picked up, removed when answered. Empty = none.
BRIDGE_ACK_REACTION=👀
# Let Grok Bot post new messages that are not answers (buzz_post_message tool).
# Off by default: with it on, anything that can steer Grok Bot can post anywhere the bot is.
BRIDGE_ALLOW_FREE_POSTING=false
# Let Grok Bot read any channel the bot is in and search messages (buzz_read_channel,
# buzz_search). Off by default: a member could ask it to quote a private channel.
# Grok Bot can always read the thread a question came from.
BRIDGE_ALLOW_READING=false

# --- Advanced ------------------------------------------------------------------

# Port inside the container for the public listener.
BRIDGE_PORT=8787
BRIDGE_LOG_LEVEL=info
# Bring an existing Buzz identity instead of letting the bridge make one (nsec or hex).
# Leave empty: the bridge creates and stores a key on first start.
BUZZ_PRIVATE_KEY=
# Any BUZZ_ACP_* variable is passed to Block's agent runner and overrides the
# bridge's defaults. Only change these if you know buzz-acp well.
