{
  "name": "grokbot-buzz-bridge",
  "version": "0.1.0",
  "description": "Puts a Grok Bot into a Buzz community: Buzz questions wake a Grok Bot routine, and Grok Bot answers through a Buzz connector.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gbb": "src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test 'test/unit/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
